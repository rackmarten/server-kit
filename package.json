    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/static": "^8.3.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0",
    "postgres": "^3.4.5",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@rackmarten/eslint-config": "^0.10.0",
    "@types/node": "^26.6.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "typescript": "^5.6.3"
  }
}
